newdata = X_te,
new.times = new.times,
event.library = event_lib,
cens.library = cens_lib,
selection = "ensemble",
control = list(saveFitLibrary = TRUE),
nFolds = 5,
verbose = FALSE)
# Inspect the fitted ensemble through the user-facing interface
print(fit_sl)
summary(fit_sl)
round(event_weights(fit_sl), 3)
plot_benchmark(
object = fit_sl,
newdata = X_te,
time = test$duration,
event = test$event,
eval_times = new.times)
shap_vals <- explain_kernel(
model = fit_sl,
X_explain = X_te[1:50, ],
X_background = X_tr[1:100, ],
nsim = 10)
plot_beeswarm(
shap_values = shap_vals,
data = X_te[1:50, ],
top_n = 8)
rmst_results <- estimate_marginal_rmst(
fit = fit_sl,
data = metabric,
trt_col = "x4",
times = new.times,
tau = 100,
inference = TRUE,
B = 200,
seed = 123)
rmst_results$ATE_RMST
rmst_results$SE_RMST
rmst_results$CI_RMST
format.pval(rmst_results$p_value, digits = 3, eps = 1e-16)
p1 <- plot_marginal_rmst_curve(
fit = fit_sl,
data = metabric,
trt_col = "x4",
times = new.times,
tau_seq = seq(50, 300, by = 50),
inference = TRUE,
B = 200,
seed = 123,
ci_level = 0.95)
p2 <- plot_rmst_vs_obs(
fit = fit_sl,
data = metabric,
time_col = "duration",
event_col = "event",
times = new.times,
tau = 350)
p1 + p2
sessionInfo()
